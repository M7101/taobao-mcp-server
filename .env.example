# Bind the Taobao MCP only to this computer. Keep this on loopback when using
# Secure MCP Tunnel so the server is not exposed to your LAN.
HOST=127.0.0.1

# Trust requests arriving from local loopback (the tunnel-client process).
# Remote callers still require bearer/OAuth authentication.
MCP_TRUST_LOOPBACK=true

# Public MCP URL used by OAuth discovery for non-loopback callers.
PUBLIC_BASE_URL=http://localhost:8787

# Optional fixed authorization password/token. If omitted, the server creates
# one and stores it in mcp-auth-token.txt (which is gitignored).
MCP_AUTH_TOKEN=

# HARD SAFETY CAP FOR REAL PAYMENTS, IN CNY.
# 0 means real payment is disabled. Keep this at 0 while setting up/testing.
# Later, set an explicit amount only when you intentionally want the MCP to
# be capable of submitting a purchase up to that single-order limit.
TAOBAO_MAX_PAYMENT_CNY=0
